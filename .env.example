# From the Discord Developer Portal (https://discord.com/developers/applications),
# under your application's Bot page. The "Reset Token" button shows a new one.
DISCORD_TOKEN=""

# The IANA timezone whose midnight starts each Game Day.
GAME_TIMEZONE="America/New_York"

# The directories that hold Quests, separated by colons like a shell PATH,
# such as public Quests in quests/ and private ones kept out of this repository.
# A relative directory is relative to this project's folder.
QUESTS_DIR="quests"
