# From the Discord Developer Portal (https://discord.com/developers/applications),
# under your application's Bot page. The "Reset Token" button shows a new one.
DISCORD_TOKEN=""

# The IANA timezone whose midnight starts each Game Day, such as "America/New_York".
GAME_TIMEZONE="America/New_York"

# The SQLite file that holds the game state. A relative path starts from where you run npm start.
DB_PATH="quest-calendars-bot.sqlite"

# The directory the log files go in. A relative path starts from where you run npm start.
LOG_DIR="logs/"
