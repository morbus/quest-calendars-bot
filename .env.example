# From the Discord Developer Portal (https://discord.com/developers/applications),
# under your application's Bot page. The "Reset Token" button shows a new one.
DISCORD_TOKEN=""

# The IANA timezone whose midnight starts each Game Day.
GAME_TIMEZONE="America/New_York"

# The SQLite file that holds the game state.
DB_PATH="quest-calendars-bot.sqlite"

# The directory the log files go in.
LOG_DIR="logs"

# The name of the log file in the log directory.
LOG_FILE="quest-calendars-bot.log"
