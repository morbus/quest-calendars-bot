{
	"$schema": "https://json.schemastore.org/prettierrc.json",
	"printWidth": 120,
	"useTabs": true,
	"singleQuote": true,
	"quoteProps": "as-needed",
	"trailingComma": "all",
	"endOfLine": "lf",
	"plugins": ["prettier-plugin-embed", "prettier-plugin-sql-cst"],
	"embeddedSqlPlugin": "prettier-plugin-sql-cst",
	"embeddedSqlParser": "sqlite",
	"embeddedSqlTags": ["sql"],
	"sqlParamTypes": ["?"]
}
